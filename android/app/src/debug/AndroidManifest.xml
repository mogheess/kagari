<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
      <!--
        Host window for instrumented tests (see BlankActivity). It has to be in
        the app's own manifest: an androidTest manifest belongs to the test APK,
        whose activities run in a separate process.
      -->
      <activity
        android:name="com.manhwa.testing.BlankActivity"
        android:exported="false" />
    </application>
</manifest>
